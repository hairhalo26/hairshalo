# Python virtual environments
venv/
.venv/
env/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Environment files — contain secrets, never commit.
# Deny every .env* variant first, then re-allow the committed examples: an
# allow-list of names is how .env.prod ends up in a public repository.
.env
.env.*
!.env.example
!.env.prod.example

# Database dumps produced by scripts/backup.sh
backups/
*.sql.gz

# Local databases
*.db
*.sqlite
*.sqlite3

# Uploaded product media (local storage backend — see app/storage.py)
backend/media/
media/

# Logs
*.log

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker local state
run.broken-*/
run.stale-*/

# Supplied product photography (the originals from the supplier).
# Source assets, not code: ~520 MB, and one archive is 189 MB, which is past
# GitHub's 100 MB per-file limit -- committing it would fail the push and bloat
# every future clone. The importer reads them from disk; what ends up in the
# product catalog is the imported media, not the archives.
Product-Media/
