# Caddy terminates TLS and reverse-proxies to the API.
#
# Certificates are obtained and renewed automatically from Let's Encrypt, which
# is the main reason this is here rather than a hand-written Nginx config: an
# expired certificate is the most common way a small shop goes offline.
#
# DOMAIN and WWW_DOMAIN come from the compose env file (hairshalo.com and
# www.hairshalo.com). Both must resolve to this host before the first start, or
# the ACME challenge fails and Caddy serves a self-signed certificate instead.

# www redirects to the apex rather than serving a second copy of the site.
# Without this block Caddy has no certificate for www at all: the browser shows
# a TLS warning before it ever reaches the app, and ALLOWED_HOSTS listing www
# does nothing to help. 308 preserves the method, so a POSTed checkout that
# happens to arrive on www is not silently downgraded to GET.
{$WWW_DOMAIN} {
	redir https://{$DOMAIN}{uri} 308
}

{$DOMAIN} {
	encode zstd gzip

	# The storefront and dashboard are static files; everything under /api and
	# /media belongs to the backend.
	handle /api/* {
		reverse_proxy api:8000 {
			# The app reads these only because TRUST_PROXY=true is set on it.
			# Caddy overwrites them rather than passing a caller's version
			# through, so a spoofed X-Forwarded-For cannot defeat rate limiting.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /media/* {
		reverse_proxy api:8000
	}

	# The dashboard is protected by its login, but it should never appear in a
	# search result. The page carries a noindex meta tag; this header covers the
	# case of a crawler that reads headers and skips the body.
	handle /admin-dashboard.html {
		header X-Robots-Tag "noindex, nofollow"
		root * /srv/frontend
		file_server
	}

	handle {
		root * /srv/frontend
		try_files {path} {path}.html /index.html
		file_server
	}

	# Rate limiting at the edge is the real defence; the limiter inside the app
	# is per-process and cannot see the whole picture. Caddy's rate_limit needs
	# a plugin build — until then, keep the app-level limiter on.

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Clickjacking: nothing here is meant to be framed by another site.
		X-Frame-Options "SAMEORIGIN"
		# The storefront needs a camera for virtual try-on; nothing needs the
		# rest. Denying them means a compromised script cannot quietly ask.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		-Server
	}

	log {
		output stdout
		format json
	}
}
