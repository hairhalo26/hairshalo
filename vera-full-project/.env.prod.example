# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod must never be committed — it is in .gitignore. Anything marked
# REQUIRED has no default: compose refuses to start without it, which is
# deliberate. A silent default is how a production host ends up signing tokens
# with a key that is published on GitHub.
#
# Full walkthrough for a fresh AWS box: docs/DEPLOY-AWS.md

# --- REQUIRED ---------------------------------------------------------------
DOMAIN=hairshalo.com
WWW_DOMAIN=www.hairshalo.com
POSTGRES_USER=vera_prod
# openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_DB=vera_hair_co
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Origins allowed to call the API from a browser. Not "*".
CORS_ORIGINS=https://hairshalo.com,https://www.hairshalo.com
# Host headers this API answers to.
ALLOWED_HOSTS=hairshalo.com,www.hairshalo.com

# --- Payments ---------------------------------------------------------------
# manual = offline settlement, orders hold at Pending Payment for admin
#          confirmation. This is the launch setting.
# razorpay = live gateway. Before switching: the storefront checkout does not
#          yet render a gateway step, and the Razorpay path has never run
#          against live credentials. Rehearse on APP_ENV=staging with test keys.
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications (Amazon SES) ---------------------------------------------
# The API queues; the notifier container delivers (NOTIFY_DISPATCH=worker is
# set in the compose file and should stay that way with more than one API).
#
# SES SMTP credentials are NOT your AWS access keys — generate a dedicated SMTP
# username/password in the SES console (Account dashboard → SMTP settings →
# Create SMTP credentials). Using an IAM secret key here fails to authenticate.
#
# Host for ap-south-1 (Mumbai). Match it to the region you verified the domain
# in — SES identities do not cross regions.
NOTIFY_CHANNEL=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# MAIL_FROM must be an address on a domain verified in SES, or it is rejected.
MAIL_FROM=orders@hairshalo.com
MAIL_FROM_NAME=Hairshalo
MAIL_REPLY_TO=
ADMIN_ALERT_EMAILS=studio@hairshalo.com
STOREFRONT_URL=https://hairshalo.com
# Absolute URL of the mark used in email headers (mail cannot load relative paths).
BRAND_LOGO_URL=https://hairshalo.com/assets/hairshalo-mark-256.png

# --- Storefront economics ---------------------------------------------------
# Changed far more often than anything is rebuilt, so they live here.
SHIPPING_FLAT_FEE=499
FREE_SHIPPING_THRESHOLD=8000
LOYALTY_EARN_PER=100
LOYALTY_POINT_VALUE=1
LOYALTY_MAX_REDEEM_PCT=20
LOW_STOCK_ALERT_THRESHOLD=5

# --- Rate limits (requests/seconds) -----------------------------------------
RATE_LIMIT_PUBLIC=60/60
RATE_LIMIT_WRITE=12/60
RATE_LIMIT_LOGIN=8/300

# --- Optional ---------------------------------------------------------------
APP_VERSION=1.0.0
GIT_SHA=
BACKUP_DIR=./backups
# Off-box backup target. Without this, backups sit on the same EBS volume as
# the database they protect — see scripts/backup.sh.
BACKUP_S3_BUCKET=
