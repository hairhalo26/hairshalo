# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod must never be committed — it is in .gitignore. Anything marked
# REQUIRED has no default: compose refuses to start without it, which is
# deliberate. A silent default is how a production host ends up signing tokens
# with a key that is published on GitHub.

# --- REQUIRED ---------------------------------------------------------------
DOMAIN=hairshalo.com
POSTGRES_USER=vera_prod
POSTGRES_PASSWORD=
POSTGRES_DB=vera_hair_co
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Origins allowed to call the API from a browser. Not "*".
CORS_ORIGINS=https://hairshalo.com,https://www.hairshalo.com
# Host headers this API answers to.
ALLOWED_HOSTS=hairshalo.com,www.hairshalo.com

# --- Payments ---------------------------------------------------------------
# manual = offline settlement; razorpay = live gateway (needs the keys below)
PAYMENT_PROVIDER=manual
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications ----------------------------------------------------------
# The API queues; the notifier container delivers (NOTIFY_DISPATCH=worker is
# set in the compose file and should stay that way with more than one API).
NOTIFY_CHANNEL=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=orders@hairshalo.com
ADMIN_ALERT_EMAILS=studio@hairshalo.com
STOREFRONT_URL=https://hairshalo.com
# Absolute URL of the mark used in email headers (mail cannot load relative paths).
BRAND_LOGO_URL=https://hairshalo.com/assets/hairshalo-mark-256.png

# --- Optional ---------------------------------------------------------------
APP_VERSION=1.0.0
GIT_SHA=
BACKUP_DIR=./backups
