# Copy this file to .env and adjust as needed
# If host port 5432 is taken, docker-compose.override.yml publishes Postgres on
# 5433 instead — change the port here to match.
DATABASE_URL=postgresql+psycopg2://vera_user:vera_pass@localhost:5432/vera_hair_co
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=*

# --- Currency (display only; INR is canonical in the database) ---
BASE_CURRENCY=INR
# static = built-in indicative rates. Set to "http" plus a key for live rates.
EXCHANGE_RATE_PROVIDER=static
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_URL=https://v6.exchangerate-api.com/v6/{key}/latest/{base}
EXCHANGE_RATE_CACHE_TTL=3600

# --- Shipping (server-side only) ---
SHIPPING_FLAT_FEE=499
FREE_SHIPPING_THRESHOLD=8000

# --- Payments ---
# none     = disabled; orders go straight to Processing (default)
# manual   = offline settlement; orders wait at Pending Payment for admin confirmation
# razorpay = live gateway; requires the keys below and a webhook endpoint
PAYMENT_PROVIDER=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Notifications ---
# console = render and log only; nothing leaves the machine (default)
# smtp    = real delivery through the SMTP server below
# null    = record every message and mark it Suppressed; send nothing
NOTIFY_CHANNEL=console
# background = send after the HTTP response (default, single web process)
# worker     = never automatically; run `python -m app.notify_worker --loop`
# inline     = send during the request (test/debug only)
NOTIFY_DISPATCH=background
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_RETRY_BASE_SECONDS=60
NOTIFY_BATCH_SIZE=25

MAIL_FROM=orders@hairshalo.com
MAIL_FROM_NAME=Hairshalo
# Absolute URL of the Hairshalo mark for email headers. Leave blank to use
# the plain-text wordmark (mail clients cannot load relative paths).
# e.g. https://your-domain/assets/hairshalo-mark-256.png
BRAND_LOGO_URL=
MAIL_REPLY_TO=
# Who gets new-order / payment-failed / low-stock alerts (comma separated)
ADMIN_ALERT_EMAILS=
# Stock at or below this triggers a low-stock alert
LOW_STOCK_ALERT_THRESHOLD=5
# Used to build links inside emails
STOREFRONT_URL=http://localhost:5500

# Only needed when NOTIFY_CHANNEL=smtp. For Gmail this must be an App Password,
# not the account password — and never commit the real .env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_TIMEOUT=20

# --- Environment & deployment ---
# development | staging | production.
# With APP_ENV=production the startup preflight REFUSES to boot on an unsafe
# setting (default SECRET_KEY, CORS_ORIGINS=*, empty ALLOWED_HOSTS, the seeded
# admin password, pending migrations...). See the README's deployment chapter.
APP_ENV=development
APP_VERSION=1.0.0
GIT_SHA=
# Host headers the API answers to. Empty = any, which production rejects.
ALLOWED_HOSTS=
# Set TRUST_PROXY only when a reverse proxy really is in front: it makes the
# app believe X-Forwarded-For, which is caller-supplied text.
TRUST_PROXY=false
FORCE_HTTPS=false
HSTS_MAX_AGE=31536000
LOG_LEVEL=INFO
# json | text. Defaults to json in production, text elsewhere.
LOG_FORMAT=

# --- Rate limiting (requests/seconds) ---
# Blank = on in production, off elsewhere, so local test suites are not throttled.
RATE_LIMIT_ENABLED=
RATE_LIMIT_PUBLIC=60/60
RATE_LIMIT_WRITE=12/60
RATE_LIMIT_LOGIN=8/300

# --- Database pool ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --- Loyalty ---
# 1 point per LOYALTY_EARN_PER rupees spent, each worth LOYALTY_POINT_VALUE
# rupees, covering at most LOYALTY_MAX_REDEEM_PCT% of an order.
LOYALTY_EARN_PER=100
LOYALTY_POINT_VALUE=1
LOYALTY_MAX_REDEEM_PCT=20

# --- Reviews ---
# Reviews are held for moderation before they count towards a rating.
REVIEWS_REQUIRE_MODERATION=true
